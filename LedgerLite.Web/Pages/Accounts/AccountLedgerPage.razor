@page "/accounts/{Id:int}/ledger"
@implements IDisposable
@using System.Globalization
@inject LedgerApiClient Api
@inject NavigationManager Navigation

<PageTitle>@(_ledger is null ? "Ledger" : $"{_ledger.Code} · {_ledger.Name}") · LedgerLite</PageTitle>

<p class="breadcrumb"><a href="/accounts">Accounts</a> / @(_ledger?.Code ?? Id.ToString())</p>

<PageHeader Title="@Title" Subtitle="@Subtitle">
    @if (_ledger is not null)
    {
        <AccountTypeBadge Type="@_ledger.Type" />
    }
</PageHeader>

<ErrorBanner @bind-Message="_error" />

<div class="filter-bar">
    <div class="filter-field">
        <BitDatePicker @bind-Value="_from"
                       @bind-Value:after="OnRangeChanged"
                       Label="From"
                       Placeholder="Start of records"
                       Culture="CultureInfo.InvariantCulture"
                       DateFormat="yyyy-MM-dd"
                       AllowTextInput="true" />
    </div>
    <div class="filter-field">
        <BitDatePicker @bind-Value="_to"
                       @bind-Value:after="OnRangeChanged"
                       Label="To"
                       Placeholder="Latest"
                       Culture="CultureInfo.InvariantCulture"
                       DateFormat="yyyy-MM-dd"
                       AllowTextInput="true" />
    </div>
    <BitButton Variant="BitVariant.Text" IsEnabled="_from is not null || _to is not null" OnClick="ClearDates">
        Clear dates
    </BitButton>
</div>

@if (_rangeError is not null)
{
    <div class="field-error">@_rangeError</div>
}

@if (_ledger is null)
{
    if (_loading)
    {
        <LoadingIndicator Text="Loading ledger…" />
    }
    else
    {
        <p class="empty-state">This account could not be loaded. <a href="/accounts">Back to accounts</a></p>
    }
}
else
{
    <div class="@(_loading ? "reloading" : "")">
        <div class="stat-row">
            <div class="stat">
                <div class="stat-label">Opening balance</div>
                <div class="stat-value">@Fmt.Money(_ledger.OpeningBalance)</div>
            </div>
            <div class="stat">
                <div class="stat-label">Total debits</div>
                <div class="stat-value">@Fmt.Money(_ledger.TotalDebits)</div>
            </div>
            <div class="stat">
                <div class="stat-label">Total credits</div>
                <div class="stat-value">@Fmt.Money(_ledger.TotalCredits)</div>
            </div>
            <div class="stat">
                <div class="stat-label">Closing balance</div>
                <div class="stat-value">@Fmt.Money(_ledger.ClosingBalance)</div>
            </div>
        </div>

        @if (_ledger.TotalLines == 0)
        {
            <p class="empty-state">No postings in this period.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Entry</th>
                            <th>Description</th>
                            <th>Reference</th>
                            <th class="num">Debit</th>
                            <th class="num">Credit</th>
                            <th class="num">Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_ledger.Page > 1)
                        {
                            <tr class="group-row">
                                <td colspan="6">Brought forward from the previous page</td>
                                <td class="num">@Fmt.Money(_ledger.BroughtForward)</td>
                            </tr>
                        }
                        else if (_ledger.From is not null)
                        {
                            <tr class="group-row">
                                <td colspan="6">Opening balance</td>
                                <td class="num">@Fmt.Money(_ledger.OpeningBalance)</td>
                            </tr>
                        }
                        @foreach (var line in _ledger.Lines)
                        {
                            <tr class="clickable" @onclick="() => OpenEntry(line.EntryId)">
                                <td>@Fmt.Date(line.Date)</td>
                                <td>
                                    <a href="/journal/@line.EntryId" @onclick:stopPropagation="true">#@line.EntryId</a>
                                </td>
                                <td>@line.Description</td>
                                <td class="mono">@line.Reference</td>
                                <td class="num">@Fmt.MoneyOrBlank(line.Debit)</td>
                                <td class="num">@Fmt.MoneyOrBlank(line.Credit)</td>
                                <td class="num @(line.RunningBalance < 0 ? "abnormal" : "")">@Fmt.Money(line.RunningBalance)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4">Totals and closing balance for the whole period</td>
                            <td class="num">@Fmt.Money(_ledger.TotalDebits)</td>
                            <td class="num">@Fmt.Money(_ledger.TotalCredits)</td>
                            <td class="num">@Fmt.Money(_ledger.ClosingBalance)</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <div class="pager">
                <span class="muted">Showing @FirstShown–@LastShown of @_ledger.TotalLines lines</span>
                <div class="pager-buttons">
                    <BitButton Variant="BitVariant.Outline" IsEnabled="@(_page > 1 && !_loading)"
                               OnClick="() => GoToPage(_page - 1)">Previous</BitButton>
                    <span>Page @_page of @TotalPages</span>
                    <BitButton Variant="BitVariant.Outline" IsEnabled="@(_page < TotalPages && !_loading)"
                               OnClick="() => GoToPage(_page + 1)">Next</BitButton>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private AccountLedgerDto? _ledger;
    private DateTimeOffset? _from;
    private DateTimeOffset? _to;
    private string? _rangeError;
    private string? _error;
    private bool _loading = true;
    private int _loadedId = -1;
    private CancellationTokenSource? _cts;

    private string Title => _ledger is null ? "Account ledger" : $"{_ledger.Code} · {_ledger.Name}";

    private const int PageSize = 50;
    private int _page = 1;

    private int TotalPages => _ledger is null ? 1 : Math.Max(1, (int)Math.Ceiling(_ledger.TotalLines / (double)PageSize));
    private int FirstShown => _ledger is null || _ledger.Lines.Count == 0 ? 0 : (_ledger.Page - 1) * PageSize + 1;
    private int LastShown => FirstShown == 0 ? 0 : FirstShown + _ledger!.Lines.Count - 1;

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > TotalPages || page == _page) return;
        _page = page;
        await LoadAsync();
    }

    // The normal balance comes from the server; the wording only explains it
    private string Subtitle
    {
        get
        {
            if (_ledger is null) return string.Empty;
            var normal = _ledger.NormalBalance.ToLowerInvariant();
            var opposite = normal == "debit" ? "credit" : "debit";
            return $"A {normal}-normal account: a {normal} increases the balance and a {opposite} decreases it.";
        }
    }

    // Reload if the route changes to a different account
    protected override async Task OnParametersSetAsync()
    {
        if (Id == _loadedId) return;

        _loadedId = Id;
        _ledger = null;
        _from = null;
        _to = null;
        _rangeError = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // If the dates change quickly, abandon the older request
        _cts?.Cancel();
        _cts = new CancellationTokenSource();
        var cts = _cts;

        _loading = true;
        _error = null;

        try
        {
            var result = await Api.GetLedgerAsync(Id, ToDate(_from), ToDate(_to), _page, PageSize, cts.Token);

            if (!cts.IsCancellationRequested)
                _ledger = result;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (ApiException ex)
        {
            if (!cts.IsCancellationRequested)
                _error = ex.Message;
        }
        finally
        {
            if (_cts == cts)
                _loading = false;
        }
    }

    private async Task OnRangeChanged()
    {
        if (_from is { } from && _to is { } to && from.Date > to.Date)
        {
            _rangeError = "'From' must not be after 'To'.";
            return;
        }

        _rangeError = null;
        await LoadAsync();
    }

    private async Task ClearDates()
    {
        _from = null;
        _to = null;
        _rangeError = null;
        await LoadAsync();
    }

    private static DateOnly? ToDate(DateTimeOffset? value) =>
        value is { } picked ? DateOnly.FromDateTime(picked.Date) : null;

    private void OpenEntry(int entryId) => Navigation.NavigateTo($"/journal/{entryId}");

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}