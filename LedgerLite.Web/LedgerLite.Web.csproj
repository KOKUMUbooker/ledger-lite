<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
	<RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
	  <PackageReference Include="Bit.BlazorUI" Version="10.6.2" />
	  <PackageReference Include="Bit.BlazorUI.Assets" Version="10.6.2" />
	  <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.13" />
      <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
	  <PackageReference Include="Bit.BlazorUI.Icons" Version="10.6.2" />
	  <!-- In case you ever want to run client separately, ensure to install Microsoft.AspNetCore.Components.WebAssembly.DevServer -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LedgerLite.Contracts\LedgerLite.Contracts.csproj" />
  </ItemGroup>

</Project>
