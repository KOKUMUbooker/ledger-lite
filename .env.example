# LedgerLite configuration.
# Copy this file to .env and fill it in. NEVER commit .env, only this example.
#
# Names use "__" (two underscores) for nesting:
#   Authentication__Google__ClientId  means  Authentication:Google:ClientId
# Values with ; or \ are wrapped in single quotes so nothing is mangled.

# ---------------------------------------------------------------
# Database
# ---------------------------------------------------------------
ConnectionStrings__LedgerDb='Server=(localdb)\MSSQLLocalDB;Database=LedgerLite;Trusted_Connection=True;TrustServerCertificate=True'

# ---------------------------------------------------------------
# Google sign-in  (Cloud Console > APIs & Services > Credentials)
# Redirect URI to register: http://localhost:5059/signin-google
# Leave both empty to disable Google sign-in.
# ---------------------------------------------------------------
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=

# ---------------------------------------------------------------
# GitHub sign-in  (Settings > Developer settings > OAuth Apps)
# Callback URL to register: http://localhost:5059/signin-github
# One callback URL per GitHub OAuth app: use a separate app for production.
# Leave both empty to disable GitHub sign-in.
# ---------------------------------------------------------------
Authentication__GitHub__ClientId=
Authentication__GitHub__ClientSecret=

# ---------------------------------------------------------------
# Owners: provider-prefixed ids allowed to post and reverse.
# Sign in once, open /api/auth/me, and copy the "id" value here.
# Examples: github:1234567   google:109876543210123456789
# Everyone else who signs in is a read-only Visitor.
# ---------------------------------------------------------------
Auth__Owners__0=
Auth__Owners__1=

# ---------------------------------------------------------------
# Development only: enables /api/auth/dev-login (sign in without OAuth).
# Only works when ASPNETCORE_ENVIRONMENT=Development. Leave unset in production.
# ---------------------------------------------------------------
Auth__EnableDevLogin=true

# ---------------------------------------------------------------
# Rate limiting. All optional: these are the defaults.
# Set RateLimiting__Enabled=false to switch it off (handy for load testing).
# ---------------------------------------------------------------
RateLimiting__Enabled=true
RateLimiting__ApiPerMinute=300          # per-IP floor for all API calls
RateLimiting__ReadsPerMinute=120        # per signed-in user (per IP if anonymous)
RateLimiting__WritesPerMinute=20        # per signed-in user (per IP if anonymous)
RateLimiting__SignInPerMinute=10        # sign-in attempts per window, per IP
RateLimiting__SignInWindowMinutes=1     # use 15 for "10 attempts per 15 minutes"